# Copy to .env (or set these in Render → Environment). Never commit real values.

# Postgres connection string (Neon). Leave empty to use the local JSON file store (data/drafts.json).
DATABASE_URL=

# Secret the owner's local app sends as "Authorization: Bearer <token>". Long and random.
OWNER_TOKEN=

# Field users: name:code pairs. One code per person so a code can be revoked alone.
FIELD_CODES=عز:482913,أحمد:775120

# What each field person may ASK about: deals, money (collections, payments, balances), expenses, inventory.
# Not listed = everything. Cash, profit, capital and partners are never in the snapshot at all.
FIELD_SCOPES=أحمد:deals+money

# Gemini key used ONLY on the server. The capture page never sees it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=8790
